#!/usr/bin/env bash
set -e

. /container.init/common.sh

function start_application {
    if [ ! -e /dev/kvm ]; then
       set +e
       mknod /dev/kvm c 10 $(grep '\<kvm\>' /proc/misc | cut -f 1 -d' ')
       set -e

    fi

    chown root:kvm /dev/kvm
    chmod 660 /dev/kvm

    mount -o remount,rw /sys

    groupmod -g 42436 nova 2>/dev/null || groupadd -g 42436 nova 2>/dev/null || true
    usermod -u 42436 -g 42436 nova 2>/dev/null || useradd -u 42436 -g 42436 -s /bin/false -d /var/lib/nova nova 2>/dev/null || true

    exec /usr/sbin/libvirtd --listen
}

start_application
