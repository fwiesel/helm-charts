# SCI sysext consumer image.
#
# Deliberately tiny: the host's own systemctl and systemd-sysext run through
# nsenter, so this image needs no systemd of its own. FROM is pinned by
# digest; resolve a new one with
#   docker buildx imagetools inspect docker.io/library/debian:trixie-slim
FROM docker.io/library/debian@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        coreutils \
        curl \
        openssl \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

COPY sci-consumer.sh /usr/local/bin/sci-consumer.sh
RUN chmod 0755 /usr/local/bin/sci-consumer.sh

ENTRYPOINT ["/usr/local/bin/sci-consumer.sh"]
